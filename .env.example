# Core
# 唯一权威 env 文件：仅维护仓库根目录 `.env`
# 不要在 `apps/server/.env`、`apps/web/.env` 下再放一份同名变量，避免 Prisma / Nest / Vite 读取到不同值。
NODE_ENV=development
PORT=3000
# Runtime persistence guard
# 开发环境默认允许内存回退；生产环境必须显式设为 false，避免数据库不可用时出现“假成功写入”。
ALLOW_IN_MEMORY_FALLBACK=true

# Database
# Prisma runtime:
# - 当前项目更稳的运行时方案是 Supabase transaction pooler `:6543`
# - 记得加上 `?pgbouncer=true&connection_limit=1`，避免 Prisma 在池化场景下放大连接数
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>
# Prisma migrate / db push:
# - 若当前环境支持 IPv6，可优先使用 direct host：postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# - 若当前环境无法访问 direct host，可改用 Supavisor session mode `:5432`
DIRECT_URL=postgresql://<user>:<password>@<host>:<port>/<db>
# Supabase (recommended for auth + persistence)
# 当前推荐方案：Supabase Auth 邮箱 OTP + Anonymous Sign-In 升级
# - 不需要额外短信服务商
# - 前端使用 VITE_SUPABASE_* 登录
# - 后端使用 SUPABASE_* 校验 access token，并把同一 user id 写入 Prisma
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# AI Provider Endpoints & Keys
# PRIMARY_*: 百炼主线路（文本 / 报告 / 翻译 / STT / TTS）
# SECONDARY_*: 备用线路提供方（主线路失败/超时后的回退）
PRIMARY_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PRIMARY_AUDIO_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PRIMARY_REALTIME_API_URL=https://dashscope.aliyuncs.com/api-ws/v1/realtime
PRIMARY_API_KEY=<your-bailian-api-key>
PRIMARY_REALTIME_API_KEY=<optional-realtime-provider-api-key>

SECONDARY_API_URL=https://<your-secondary-provider>/v1
SECONDARY_API_KEY=<your-secondary-provider-api-key>

# Model Routing (required)
# 所有模型切换都通过这组变量完成，不需要改代码。
# PRIMARY_MODEL: 主模型（文本导师）
# SECONDARY_MODEL: 第一备用模型
# THIRD_MODEL: 第二备用模型
PRIMARY_MODEL=qwen3.6-plus
SECONDARY_MODEL=qwen3.5-flash
THIRD_MODEL=deepseek-chat
PRIMARY_MODEL_TIMEOUT_MS=6500
SECONDARY_MODEL_TIMEOUT_MS=3200
THIRD_MODEL_TIMEOUT_MS=2200

# Specialized Models
# STT_MODEL: 语音识别模型
# TTS_MODEL: 语音合成模型
# REALTIME_MODEL: 实时对话模型
# REALTIME_TRANSCRIBE_MODEL: realtime 链路专用转写模型；留空时不限定额外转写模型，优先走 Omni 自身多语种理解
# IMMERSIVE_REPORT_MODEL: immersive 结束后的快速结构化报告模型
# TRANSLATION_MODEL: 翻译模型（可与 SECONDARY/THIRD 一致）
STT_MODEL=qwen3-asr-flash
TTS_MODEL=qwen3-tts-instruct-flash
REALTIME_MODEL=qwen3-omni-flash-realtime
REALTIME_TRANSCRIBE_MODEL=
IMMERSIVE_REPORT_MODEL=qwen3.5-flash
TRANSLATION_MODEL=qwen-mt-flash

# Auth
# 当前 Google 仅保留占位，未接入前可以留空
JWT_SECRET=<your-jwt-secret>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend (Vite)
VITE_API_URL=/api
VITE_PROXY_API=http://127.0.0.1:3000
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Tooling (scripts/dev.js)
LUVTALK_HEALTH_ATTEMPTS=60
LUVTALK_HEALTH_DELAY=1000
