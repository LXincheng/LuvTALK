# Core
NODE_ENV=development
PORT=3000
# Runtime persistence guard
# 开发环境默认允许内存回退；生产环境必须显式设为 false，避免数据库不可用时出现“假成功写入”。
ALLOW_IN_MEMORY_FALLBACK=true

# Database
# Prisma runtime:
# - 优先使用 direct / session 模式，避免当前网络环境下 transaction pooler `:6543` 偶发不可达
# - 只有当部署环境已验证 `:6543` 稳定时，才继续使用 transaction pooler，并保留 `?pgbouncer=true`
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>
# Prisma migrate / db push:
# - 优先使用 direct host：postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# - 若当前环境无法访问 Supabase IPv6 direct host，可改用 Supavisor session mode：postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://<user>:<password>@<host>:<port>/<db>
# Optional: 用于发布前对比本地库与远端 Supabase 是否都已应用同一套 Prisma migrations
LOCAL_DATABASE_URL=postgresql://<local-user>:<local-password>@<local-host>:<port>/<local-db>
LOCAL_DIRECT_URL=postgresql://<local-user>:<local-password>@<local-host>:<port>/<local-db>
SUPABASE_DATABASE_URL=postgresql://<supabase-user>:<supabase-password>@<supabase-host>:<port>/<supabase-db>
SUPABASE_DIRECT_URL=postgresql://<supabase-user>:<supabase-password>@<supabase-host>:<port>/<supabase-db>

# Supabase (optional)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# AI Provider Endpoints & Keys
# PRIMARY_*: 主线路提供方（高质量导师回复 + STT/TTS + Realtime）
# SECONDARY_*: 备用线路提供方（主线路失败/超时后的回退）
PRIMARY_API_URL=https://<your-primary-provider>/v1
PRIMARY_AUDIO_API_URL=https://<your-primary-provider>/v1/audio
PRIMARY_REALTIME_API_URL=ws://<your-primary-provider>/v1/realtime
PRIMARY_API_KEY=<your-primary-provider-api-key>

SECONDARY_API_URL=https://<your-secondary-provider>/v1
SECONDARY_API_KEY=<your-secondary-provider-api-key>

# Model Routing (required)
# 所有模型切换都通过这组变量完成，不需要改代码。
# PRIMARY_MODEL: 主模型（文本导师）
# SECONDARY_MODEL: 第一备用模型
# THIRD_MODEL: 第二备用模型
PRIMARY_MODEL=<primary-model-id>
SECONDARY_MODEL=<secondary-model-id>
THIRD_MODEL=<third-model-id>
PRIMARY_MODEL_TIMEOUT_MS=7000
SECONDARY_MODEL_TIMEOUT_MS=3200
THIRD_MODEL_TIMEOUT_MS=1800

# Specialized Models
# STT_MODEL: 语音识别模型
# TTS_MODEL: 语音合成模型
# REALTIME_MODEL: 实时对话模型
# TRANSLATION_MODEL: 翻译模型（可与 SECONDARY/THIRD 一致）
STT_MODEL=<stt-model-id>
TTS_MODEL=<tts-model-id>
REALTIME_MODEL=<realtime-model-id>
TRANSLATION_MODEL=<translation-model-id>

# Auth
JWT_SECRET=<your-jwt-secret>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend (Vite)
VITE_API_URL=/api
VITE_PROXY_API=http://127.0.0.1:3000
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Tooling (scripts/dev.js)
LUVTALK_HEALTH_ATTEMPTS=60
LUVTALK_HEALTH_DELAY=1000
