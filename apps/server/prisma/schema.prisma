generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 

enum FavoriteType {
  phrase
  cultural
  vocabulary
  scenario
}

model Conversation {
  id             String    @id @default(cuid())
  scenarioId     String
  targetLanguage String
  nativeLanguage String?
  messages       Json
  score          Int?
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  favorites      Favorite[]
}

model Favorite {
  id              String        @id @default(cuid())
  title           String
  content         String
  type            FavoriteType
  metadata        Json?
  createdAt       DateTime      @default(now())
  conversationId  String?
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
}

model TranslationRecord {
  id              String   @id @default(cuid())
  sourceLanguage  String
  targetLanguage  String
  sourceText      String
  translatedText  String
  romanization    String?
  cultureNote     String?
  createdAt       DateTime @default(now())
}

model User {
  id             String           @id
  email          String?          @unique
  name           String?
  avatarUrl      String?
  createdAt      DateTime         @default(now())
  conversations  Conversation[]
  favorites      Favorite[]
  sessionTokens  SessionToken[]
}

model SessionToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}
