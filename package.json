{
  "name": "luvtalk-monorepo",
  "private": true,
  "packageManager": "pnpm@10.3.0",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "verify": "node scripts/verify.js",
    "verify:server": "node scripts/verify.js server",
    "verify:web": "node scripts/verify.js web",
    "db:check-sync": "node scripts/check-db-sync.js"
  },
  "devDependencies": {
    "turbo": "^2.6.1"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  }
}
